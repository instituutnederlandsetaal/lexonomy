CREATE TABLE IF NOT EXISTS dicts (id TEXT PRIMARY KEY, title TEXT, language TEXT);
CREATE INDEX IF NOT EXISTS title ON dicts (title);
CREATE TABLE IF NOT EXISTS users (email TEXT PRIMARY KEY, passwordHash TEXT, sessionKey TEXT, sessionLast DATETIME, consent INTEGER);
CREATE INDEX IF NOT EXISTS email_password ON users (email, passwordHash);
CREATE INDEX IF NOT EXISTS email_session ON users (email, sessionKey, sessionLast);
CREATE TABLE IF NOT EXISTS user_dict (id INTEGER PRIMARY KEY AUTOINCREMENT, dict_id TEXT, user_email TEXT);
CREATE INDEX IF NOT EXISTS dict_id ON user_dict (dict_id);
CREATE INDEX IF NOT EXISTS user_email ON user_dict (user_email);
CREATE TABLE IF NOT EXISTS recovery_tokens (email text, requestAddress text, token text, expiration datetime, usedDate datetime, usedAddress text);
CREATE TABLE IF NOT EXISTS register_tokens (email text, requestAddress text, token text, expiration datetime, usedDate datetime, usedAddress text);
CREATE TABLE IF NOT EXISTS dict_fav (dict_id text, user_email text);
CREATE INDEX IF NOT EXISTS fav_dict_id on dict_fav (dict_id);
CREATE INDEX IF NOT EXISTS fav_user_email on dict_fav (user_email);
