{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "@elexis-eu/xonomy": ["./node_modules/@elexis-eu/xonomy/dist/src/xonomy.d.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["app.js", "js/**/*.ts", "components/**/*.vue", "components/**/*.ts", "widgets/**/*.ts"]
}
