{
  "name": "lexonomy",
  "version": "1.0.0",
  "description": "Lexonomy is a light-weight dictionary editor",
  "private": true,
  "devDependencies": {
    "@elexis-eu/xonomy": "^1.3.1",
    "@riotjs/compiler": "^9.4.9",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "concurrently": "^9.2.0",
    "postcss": "^8.5.6",
    "postcss-url": "^10.1.3",
    "riot": "^9.4.9",
    "rollup": "^4.44.2",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-riot": "^9.0.2"
  },
  "scripts": {
    "build": "npm run build:riot && npm run build:editor",
    "build:riot": "rollup -c",
    "build:editor": "npm --prefix editor run build",
    "watch": "concurrently \"npm run watch:riot\" \"npm run watch:editor\"",
    "watch:riot": "rollup -c -w",
    "watch:editor": "npm --prefix editor run serve"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elexis-eu/lexonomy.git"
  },
  "keywords": [
    "lexonomy",
    "dictionary",
    "lexicography"
  ],
  "author": "Lexical Computing",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/elexis-eu/lexonomy/issues"
  },
  "homepage": "https://github.com/elexis-eu/lexonomy#readme"
}
